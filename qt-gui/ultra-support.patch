+bool atsx11::detectUltra()
+{
+    m_ultraPath = ultra::findDevice();
+    if (m_ultraPath.isEmpty())
+        return false;
+
+    // findDevice() matched the Ultra's USB ids and vendor collection, so this
+    // IS an Ultra. Whether it answers a read is a separate question: the mouse
+    // sleeps when idle and stops serving config requests while the dongle keeps
+    // answering. Never fall back to the X11 UI on a failed read -- that would
+    // silently hide 2K/4K/8K on a device that supports them.
+    m_isUltra = true;
+    m_currentDevicePath = m_ultraPath;
+    setWindowTitle(QStringLiteral("Attack Shark X11 Ultra"));
+
+    // The Ultra reaches 2000/4000/8000 Hz, which the X11 protocol cannot encode,
+    // so the fixed four-entry list is replaced with the full set. The Hz value
+    // is kept in item data rather than implied by the index.
+    ui->cbox_pollingrate->clear();
+    for (int i = 0; i < ultra::kRateCount; ++i) {
+        ui->cbox_pollingrate->addItem(
+            QStringLiteral("%1HZ").arg(ultra::kRates[i].hz), ultra::kRates[i].hz);
+    }
+
+    // LED/colour offsets for this device are not decoded yet; leave the control
+    // visible but inert rather than writing bytes we have not verified.
+    ui->cbox_colormodes->setEnabled(false);
+    ui->cbox_colormodes->setToolTip(
+        QStringLiteral("LED control is not yet supported on the X11 Ultra."));
+
+    // The LED tile has nothing to show on this device, so give the space to the
+    // one reading people actually want at a glance.
+    ui->lbl_ledValue->setText(QStringLiteral("Active DPI"));
+    ui->lbl_infoLEDValue->setText(QStringLiteral("..."));
+
+    // The stock slider carries the X11's 4..50 key-response range. The Ultra
+    // stores a plain debounce in ms and applyUltra clamps to 0..30, so make the
+    // control match what can actually be written instead of implying 50 works.
+    ui->sld_keyresptime->setRange(0, 30);
+
+    // Sleep timing is in the Ultra's flash at OffSleepTime but the payload is
+    // not decoded, so applyUltra does not write it. Disable rather than leave
+    // sliders that look live and silently do nothing on Apply.
+    ui->sldr_sleeptime->setEnabled(false);
+    ui->sldr_deepSleepTime->setEnabled(false);
+    const QString sleepTip =
+        QStringLiteral("Sleep timing is not decoded on the X11 Ultra yet.");
+    ui->sldr_sleeptime->setToolTip(sleepTip);
+    ui->sldr_deepSleepTime->setToolTip(sleepTip);
+
+    buildUltraDpiUi();
+
+    if (!refreshUltraUi()) {
+        // Asleep. Poll until it wakes rather than making the user restart.
+        if (!m_ultraWake) {
+            m_ultraWake = new QTimer(this);
+            m_ultraWake->setInterval(2000);
+            connect(m_ultraWake, &QTimer::timeout, this, [this]() {
+                if (refreshUltraUi())
+                    m_ultraWake->stop();
+            });
+        }
+        m_ultraWake->start();
+    }
+    return true;
+}
+
+void atsx11::buildUltraDpiUi()
+{
+    if (m_dpiGroup)
+        return;
+
+    // Every widget in the .ui is absolutely placed inside a window pinned to
+    // 720x320, so there is no free space to grow into. Add the panel below the
+    // existing controls and push the Apply row and status bar down to suit.
+    m_dpiGroup = new QGroupBox(QStringLiteral("DPI"), ui->centralwidget);
+    m_dpiGroup->setGeometry(220, 280, 491, 70);
+
+    auto *row = new QHBoxLayout(m_dpiGroup);
+    row->addWidget(new QLabel(QStringLiteral("Stage"), m_dpiGroup));
+
+    m_dpiStage = new QComboBox(m_dpiGroup);
+    m_dpiStage->setMinimumWidth(165);
+    row->addWidget(m_dpiStage);
+
+    m_dpiValue = new QSpinBox(m_dpiGroup);
+    m_dpiValue->setRange(ultra::kDpiStep, ultra::kDpiMax);
+    m_dpiValue->setSingleStep(ultra::kDpiStep);
+    m_dpiValue->setSuffix(QStringLiteral(" DPI"));
+    m_dpiValue->setMinimumWidth(115);
+    m_dpiValue->setToolTip(QStringLiteral(
+        "50 to 30000 in steps of 50, then 30100 to 60000 in steps of 100."));
+    row->addWidget(m_dpiValue);
+
+    m_dpiSetActive = new QPushButton(QStringLiteral("Set active"), m_dpiGroup);
+    m_dpiSetActive->setToolTip(
+        QStringLiteral("Make this the stage the mouse is currently using."));
+    row->addWidget(m_dpiSetActive);
+    row->addStretch();
+
+    connect(m_dpiStage, qOverload<int>(&QComboBox::currentIndexChanged),
+            this, &atsx11::onDpiStageChanged);
+    connect(m_dpiValue, qOverload<int>(&QSpinBox::valueChanged),
+            this, &atsx11::onDpiValueChanged);
+    // Snap only once the field is done being edited, otherwise typing "1" on
+    // the way to 1600 gets rewritten to 50 under the cursor.
+    connect(m_dpiValue, &QAbstractSpinBox::editingFinished, this, [this]() {
+        const int snapped = ultra::snapDpi(m_dpiValue->value());
+        if (snapped != m_dpiValue->value())
+            m_dpiValue->setValue(snapped);
+    });
+    connect(m_dpiSetActive, &QPushButton::clicked, this, [this]() {
+        m_dpiCurrent = m_dpiStage->currentIndex();
+        refreshDpiCombo();
+    });
+
+    ui->verticalLayoutWidget->setGeometry(390, 358, 321, 45);
+    ui->horizontalLayoutWidget->setGeometry(0, 408, 721, 58);
+    setMinimumSize(720, 470);
+    setMaximumSize(720, 470);
+    resize(720, 470);
+}
+
+void atsx11::refreshDpiCombo()
+{
+    if (!m_dpiStage)
+        return;
+
+    const int keep = m_dpiStage->currentIndex();
+    {
+        QSignalBlocker block(m_dpiStage);
+        m_dpiStage->clear();
+        for (int i = 0; i < m_dpiPending.size(); ++i) {
+            QString label = QStringLiteral("Stage %1: %2").arg(i + 1).arg(m_dpiPending[i]);
+            if (i == m_dpiCurrent)
+                label += QStringLiteral("  (active)");
+            m_dpiStage->addItem(label, m_dpiPending[i]);
+        }
+        if (keep >= 0 && keep < m_dpiStage->count())
+            m_dpiStage->setCurrentIndex(keep);
+    }
+    if (m_dpiSetActive)
+        m_dpiSetActive->setEnabled(m_dpiStage->currentIndex() != m_dpiCurrent);
+}
+
+void atsx11::onDpiStageChanged(int index)
+{
+    if (index < 0 || index >= m_dpiPending.size())
+        return;
+    QSignalBlocker block(m_dpiValue);
+    m_dpiValue->setValue(m_dpiPending[index]);
+    if (m_dpiSetActive)
+        m_dpiSetActive->setEnabled(index != m_dpiCurrent);
+}
+
+void atsx11::onDpiValueChanged(int dpi)
+{
+    const int stage = m_dpiStage ? m_dpiStage->currentIndex() : -1;
+    if (stage < 0 || stage >= m_dpiPending.size())
+        return;
+    m_dpiPending[stage] = dpi;   // snapped on editingFinished and again on Apply
+    refreshDpiCombo();
+}
+
+bool atsx11::refreshUltraUi()
+{
+    const ultra::Settings s = ultra::readSettings(m_ultraPath);
+    if (!s.valid) {
+        // Don't let Apply write a rate we never confirmed -- the combo would be
+        // showing a default rather than what the mouse actually holds.
+        ui->btn_apply->setEnabled(false);
+        ui->lbl_debug->setText(QStringLiteral(
+            "<html><head/><body><p><span style='color:orange;'>X11 Ultra detected, "
+            "but it is asleep. <b>Move the mouse</b> to wake it, "
+            "this will update itself.</span></p></body></html>"));
+        return false;
+    }
+
+    const int idx = ui->cbox_pollingrate->findData(s.reportRateHz);
+    if (idx >= 0)
+        ui->cbox_pollingrate->setCurrentIndex(idx);
+    ui->chbox_anglesnap->setChecked(s.angleSnap);
+    ui->chbox_rippleCTRL->setChecked(s.ripple);
+
+    // Show the debounce the mouse actually holds. Without this the slider sits
+    // at its minimum and Apply quietly writes that over whatever was set.
+    const int debounce = qBound(ui->sld_keyresptime->minimum(), s.debounceMs,
+                                ui->sld_keyresptime->maximum());
+    ui->sld_keyresptime->setValue(debounce);
+    ui->lbl_kreptimeValueDisplay->setText(
+        QString::number(debounce) + QStringLiteral(" ms"));
+
+    ui->btn_apply->setEnabled(true);
+    updateInfoLabels();
+
+    if (m_dpiGroup) {
+        const bool haveDpi = !s.dpiStages.isEmpty() && !s.dpiStages.contains(0);
+        m_dpiGroup->setEnabled(haveDpi);
+        if (haveDpi) {
+            m_dpiOnDevice = s.dpiStages;
+            m_dpiPending  = s.dpiStages;
+            m_dpiCurrent  = qBound(0, s.currentDpiStage, s.dpiStages.size() - 1);
+            m_dpiCurrentOnDevice = m_dpiCurrent;
+            refreshDpiCombo();
+            m_dpiStage->setCurrentIndex(m_dpiCurrent);
+            onDpiStageChanged(m_dpiCurrent);
+            ui->lbl_infoLEDValue->setText(
+                QStringLiteral("%1").arg(m_dpiPending[m_dpiCurrent]));
+        }
+    }
+
+    const ultra::Battery bat = ultra::readBattery(m_ultraPath);
+    if (bat.valid) {
+        ui->lbl_batteryinfo->setEnabled(true);
+        ui->pbar_batteryinfo->setEnabled(true);
+        ui->pbar_batteryinfo->setValue(bat.percent);
+        ui->lbl_isCharging->setEnabled(true);
+        ui->lbl_isCharging->setPixmap(bat.charging
+            ? QPixmap(QStringLiteral(":/images/assets/lightning.png")) : QPixmap());
+    }
+
+    ui->lbl_debug->setText(QStringLiteral(
+        "<html><head/><body><p><span style='color:green;'>X11 Ultra on %1, "
+        "%2 Hz, %3 DPI stages%4</span></p></body></html>")
+        .arg(m_ultraPath).arg(s.reportRateHz).arg(s.maxDpiStage)
+        .arg(bat.valid ? QStringLiteral(", battery %1%").arg(bat.percent) : QString()));
+    return true;
+}
+
+void atsx11::applyUltra()
+{
+    const int hz = ui->cbox_pollingrate->currentData().toInt();
+    // The slider is the X11's 4..50 key-response range; the Ultra stores a
+    // plain debounce in ms, so clamp rather than pass it through blindly.
+    const int debounce = qBound(0, ui->sld_keyresptime->value(), 30);
+
+    const ultra::Settings before = ultra::readSettings(m_ultraPath);
+    if (!before.valid) {
+        ui->lbl_debug->setText(QStringLiteral(
+            "<html><head/><body><p><span style='color:orange;'>The mouse is asleep. "
+            "Move it and try again.</span></p></body></html>"));
+        return;
+    }
+    const bool ok = ultra::applySettings(m_ultraPath, hz,
+                                         ui->chbox_anglesnap->isChecked(),
+                                         ui->chbox_rippleCTRL->isChecked(),
+                                         before.motionSync,   // untouched by this UI
+                                         debounce,
+                                         before.lod);         // untouched by this UI
+    if (!ok) {
+        ui->lbl_debug->setText(QStringLiteral("<html><head/><body><p><span style='color:red;'>Error: failed to apply settings</span></p></body></html>"));
+        QMessageBox::warning(this, QStringLiteral("Error"),
+                             QStringLiteral("Failed to apply settings to the X11 Ultra."));
+        return;
+    }
+
+    // DPI is a separate write path: only the stages the user actually touched
+    // get rewritten, and the active stage only if it moved.
+    QList<ultra::DpiWrite> dpiWrites;
+    for (int i = 0; i < m_dpiPending.size() && i < m_dpiOnDevice.size(); ++i) {
+        const int want = ultra::snapDpi(m_dpiPending[i]);
+        m_dpiPending[i] = want;
+        if (want != m_dpiOnDevice[i])
+            dpiWrites.append({i, want});
+    }
+    const int wantStage = (m_dpiCurrent != m_dpiCurrentOnDevice) ? m_dpiCurrent : -1;
+    if (!dpiWrites.isEmpty() || wantStage >= 0) {
+        if (!ultra::applyDpi(m_ultraPath, dpiWrites, wantStage)) {
+            ui->lbl_debug->setText(QStringLiteral("<html><head/><body><p><span style='color:red;'>Error: failed to write DPI</span></p></body></html>"));
+            QMessageBox::warning(this, QStringLiteral("Error"),
+                                 QStringLiteral("Failed to write DPI to the X11 Ultra."));
+            return;
+        }
+    }
+
+    // Read back so the UI shows what the device actually holds, not what we asked for.
+    saveSettings();
+    if (!refreshUltraUi())
+        return;   // refreshUltraUi already explained itself on the status line
+
+    const int shownHz  = ui->cbox_pollingrate->currentData().toInt();
+    const int shownDpi = (m_dpiCurrent >= 0 && m_dpiCurrent < m_dpiPending.size())
+                       ? m_dpiPending[m_dpiCurrent] : 0;
+    ui->lbl_debug->setText(QStringLiteral(
+        "<html><head/><body><p><span style='color:green;'>Applied, device reports %1 Hz at %2 DPI</span></p></body></html>")
+        .arg(shownHz).arg(shownDpi));
+}
