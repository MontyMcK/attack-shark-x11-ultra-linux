+bool atsx11::detectUltra()
+{
+    m_ultraPath = ultra::findDevice();
+    if (m_ultraPath.isEmpty())
+        return false;
+
+    // findDevice() matched the Ultra's USB ids and vendor collection, so this
+    // IS an Ultra. Whether it answers a read is a separate question: the mouse
+    // sleeps when idle and stops serving config requests while the dongle keeps
+    // answering. Never fall back to the X11 UI on a failed read -- that would
+    // silently hide 2K/4K/8K on a device that supports them.
+    m_isUltra = true;
+    m_currentDevicePath = m_ultraPath;
+    setWindowTitle(QStringLiteral("Attack Shark X11 Ultra"));
+
+    // The Ultra reaches 2000/4000/8000 Hz, which the X11 protocol cannot encode,
+    // so the fixed four-entry list is replaced with the full set. The Hz value
+    // is kept in item data rather than implied by the index.
+    ui->cbox_pollingrate->clear();
+    for (int i = 0; i < ultra::kRateCount; ++i) {
+        ui->cbox_pollingrate->addItem(
+            QStringLiteral("%1HZ").arg(ultra::kRates[i].hz), ultra::kRates[i].hz);
+    }
+
+    // LED/colour offsets for this device are not decoded yet; leave the control
+    // visible but inert rather than writing bytes we have not verified.
+    ui->cbox_colormodes->setEnabled(false);
+    ui->cbox_colormodes->setToolTip(
+        QStringLiteral("LED control is not yet supported on the X11 Ultra."));
+
+    if (!refreshUltraUi()) {
+        // Asleep. Poll until it wakes rather than making the user restart.
+        if (!m_ultraWake) {
+            m_ultraWake = new QTimer(this);
+            m_ultraWake->setInterval(2000);
+            connect(m_ultraWake, &QTimer::timeout, this, [this]() {
+                if (refreshUltraUi())
+                    m_ultraWake->stop();
+            });
+        }
+        m_ultraWake->start();
+    }
+    return true;
+}
+
+bool atsx11::refreshUltraUi()
+{
+    const ultra::Settings s = ultra::readSettings(m_ultraPath);
+    if (!s.valid) {
+        // Don't let Apply write a rate we never confirmed -- the combo would be
+        // showing a default rather than what the mouse actually holds.
+        ui->btn_apply->setEnabled(false);
+        ui->lbl_debug->setText(QStringLiteral(
+            "<html><head/><body><p><span style='color:orange;'>X11 Ultra detected, "
+            "but it is asleep. <b>Move the mouse</b> to wake it, "
+            "this will update itself.</span></p></body></html>"));
+        return false;
+    }
+
+    const int idx = ui->cbox_pollingrate->findData(s.reportRateHz);
+    if (idx >= 0)
+        ui->cbox_pollingrate->setCurrentIndex(idx);
+    ui->chbox_anglesnap->setChecked(s.angleSnap);
+    ui->chbox_rippleCTRL->setChecked(s.ripple);
+    ui->btn_apply->setEnabled(true);
+    updateInfoLabels();
+
+    const ultra::Battery bat = ultra::readBattery(m_ultraPath);
+    if (bat.valid) {
+        ui->lbl_batteryinfo->setEnabled(true);
+        ui->pbar_batteryinfo->setEnabled(true);
+        ui->pbar_batteryinfo->setValue(bat.percent);
+        ui->lbl_isCharging->setEnabled(true);
+        ui->lbl_isCharging->setPixmap(bat.charging
+            ? QPixmap(QStringLiteral(":/images/assets/lightning.png")) : QPixmap());
+    }
+
+    ui->lbl_debug->setText(QStringLiteral(
+        "<html><head/><body><p><span style='color:green;'>X11 Ultra on %1, "
+        "%2 Hz, %3 DPI stages%4</span></p></body></html>")
+        .arg(m_ultraPath).arg(s.reportRateHz).arg(s.maxDpiStage)
+        .arg(bat.valid ? QStringLiteral(", battery %1%").arg(bat.percent) : QString()));
+    return true;
+}
+
+void atsx11::applyUltra()
+{
+    const int hz = ui->cbox_pollingrate->currentData().toInt();
+    // The slider is the X11's 4..50 key-response range; the Ultra stores a
+    // plain debounce in ms, so clamp rather than pass it through blindly.
+    const int debounce = qBound(0, ui->sld_keyresptime->value(), 30);
+
+    const ultra::Settings before = ultra::readSettings(m_ultraPath);
+    if (!before.valid) {
+        ui->lbl_debug->setText(QStringLiteral(
+            "<html><head/><body><p><span style='color:orange;'>The mouse is asleep. "
+            "Move it and try again.</span></p></body></html>"));
+        return;
+    }
+    const bool ok = ultra::applySettings(m_ultraPath, hz,
+                                         ui->chbox_anglesnap->isChecked(),
+                                         ui->chbox_rippleCTRL->isChecked(),
+                                         before.motionSync,   // untouched by this UI
+                                         debounce,
+                                         before.lod);         // untouched by this UI
+    if (!ok) {
+        ui->lbl_debug->setText(QStringLiteral("<html><head/><body><p><span style='color:red;'>Error: failed to apply settings</span></p></body></html>"));
+        QMessageBox::warning(this, QStringLiteral("Error"),
+                             QStringLiteral("Failed to apply settings to the X11 Ultra."));
+        return;
+    }
+
+    // Read back so the UI shows what the device actually holds, not what we asked for.
+    const ultra::Settings after = ultra::readSettings(m_ultraPath);
+    saveSettings();
+    updateInfoLabels();
+    ui->lbl_debug->setText(QStringLiteral(
+        "<html><head/><body><p><span style='color:green;'>Applied, device reports %1 Hz</span></p></body></html>")
+        .arg(after.reportRateHz));
+}
