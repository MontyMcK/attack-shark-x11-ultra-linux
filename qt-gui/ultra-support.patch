+// True when an X11 Ultra is present and its config node is already usable
+// without elevation.
+bool ultraIsAccessible()
+{
+    const QString path = ultra::findDevice();
+    if (path.isEmpty())
+        return false;
+    return ::access(path.toUtf8().constData(), R_OK | W_OK) == 0;
+}
